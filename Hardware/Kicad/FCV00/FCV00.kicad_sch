  (text "FCV00 - FLIGHT CONTROLLER\nMCU pin map (STM32F405RGT6)\n  SPI1 PA5/PA6/PA7  CS PA4  INT PC4  CLKIN PB0 -> ICM-42688-P (gyro)\n  SPI2 PB13/PB14/PB15  CS PB12        -> AT7456E (OSD)\n  SPI3 PB3/PB4/PB5  CS PA15           -> W25Q128 (blackbox)\n  I2C1 PB8/PB9                        -> LPS22DF baro + GPS compass\n  USART1 PB6/PB7 -> ELRS RX     USART2 PA2/PA3 -> VTX (MSP/SmartAudio)\n  USART3 PB10/PB11 -> GPS       UART4 PA0/PA1 -> AUX\n  UART5 PC12 (AUX TX) / PD2 (ESC telemetry RX)\n  MOTOR1..4 PC6..PC9 = TIM8 CH1..CH4 (DShot / bidir DShot)\n  LED strip PA8 (TIM1 CH1)   Buzzer PC5   LEDs PC14/PC15\n  ADC: VBAT PC2 (x11 divider), CURRENT PC1, USB VBUS detect PA9\n" (at 180 20 0)
    (effects (font (size 1.5 1.5)) (justify left top))
